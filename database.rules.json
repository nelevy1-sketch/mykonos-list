{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "_analytics": {
      ".read": "auth != null && auth.uid === 'ne56ZOFgDMRfaH03WAvO7jbinty2'",

      "writes": {
        ".write": "auth != null"
      },

      "signIns": {
        ".write": "auth != null",

        "$eventId": {
          "uid": {
            ".validate": "newData.val() === auth.uid"
          }
        }
      },

      "visitorStats": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      },

      "dashboardLayout": {
        ".write": "auth != null && auth.uid === 'ne56ZOFgDMRfaH03WAvO7jbinty2'"
      }
    },

    "trips": {

      ".read": "auth != null && auth.uid === 'ne56ZOFgDMRfaH03WAvO7jbinty2'",

      "$tripId": {

        ".read": "auth != null",

        ".write": "auth != null && (!data.exists() ? newData.child('ownerId').val() === auth.uid : data.child('ownerId').val() === auth.uid)",

        "memberProfiles": {
          "$uid": {
            ".write": "auth != null && (data.parent().parent().child('ownerId').val() === auth.uid || (auth.uid === $uid && newData.exists() && ((!data.exists() && data.parent().parent().child('participantClaims').child(newData.child('participantKey').val()).val() === auth.uid) || (data.exists() && newData.child('participantKey').val() === data.child('participantKey').val()))))"
          }
        },

        "personalLocker": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || data.parent().parent().child('ownerId').val() === auth.uid)"
          }
        },

        "participantClaims": {
          "$claimKey": {
            ".write": "auth != null && (!data.exists() || data.val() === auth.uid || data.parent().parent().child('ownerId').val() === auth.uid)",
            ".validate": "newData.val() === auth.uid"
          }
        },

        "packing": {
          "users": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },

        "shopping": {
          "lists": {
            "$listType": {
              "$itemId": {
                ".write": "auth != null"
              }
            }
          },
          "status": {
            "$listType": {
              ".write": "auth != null"
            }
          }
        },

        "places": {
          "items": {
            "$placeId": {
              ".write": "auth != null && (!data.exists() || data.child('createdByUid').val() === auth.uid || root.child('trips').child($tripId).child('ownerId').val() === auth.uid)"
            }
          }
        },

        "itinerary": {
          "days": {
            "$dayKey": {
              "activities": {
                "$activityId": {
                  ".write": "auth != null && (!data.exists() || data.child('createdByUid').val() === auth.uid || root.child('trips').child($tripId).child('ownerId').val() === auth.uid)",

                  "joiners": {
                    "$uid": {
                      ".write": "auth != null && auth.uid === $uid"
                    }
                  },

                  "joinerNames": {
                    "$uid": {
                      ".write": "auth != null && auth.uid === $uid"
                    }
                  }
                }
              }
            }
          }
        },

        "photos": {
          "items": {
            "$photoId": {
              ".write": "auth != null && (!data.exists() || data.child('createdByUid').val() === auth.uid || root.child('trips').child($tripId).child('ownerId').val() === auth.uid)",

              "reactions": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid"
                }
              },

              "comments": {
                "$commentId": {
                  ".write": "auth != null && (!data.exists() || data.child('createdByUid').val() === auth.uid || root.child('trips').child($tripId).child('ownerId').val() === auth.uid || root.child('trips').child($tripId).child('photos').child('items').child($photoId).child('createdByUid').val() === auth.uid)",

                  "likes": {
                    "$uid": {
                      ".write": "auth != null && auth.uid === $uid"
                    }
                  },

                  "replies": {
                    "$replyId": {
                      ".write": "auth != null && (!data.exists() || data.child('createdByUid').val() === auth.uid || root.child('trips').child($tripId).child('ownerId').val() === auth.uid || root.child('trips').child($tripId).child('photos').child('items').child($photoId).child('createdByUid').val() === auth.uid || root.child('trips').child($tripId).child('photos').child('items').child($photoId).child('comments').child($commentId).child('createdByUid').val() === auth.uid)"
                    }
                  }
                }
              }
            }
          }
        },

        "music": {
          "items": {
            "$musicId": {
              ".write": "auth != null && (!data.exists() || data.child('createdByUid').val() === auth.uid || root.child('trips').child($tripId).child('ownerId').val() === auth.uid)"
            }
          }
        }
      }
    }
  }
}
